+++ b/Source/Campaign.cs
@@ -0,0 +1,172 @@
+using System;
+using System.Globalization;
+using System.Collections.Generic;
+using UnityEngine;
+
+namespace MegaCrew
+{
+    // Added only on explicit campaign start in a MegaCrew flight save. KSP owns
+    // serialization, so quicksave/load restores epoch and vessel together.
+    public sealed class HermesCampaign : ScenarioModule
+    {
+        public List<CrewRecord> CrewSnapshot;
+        public bool Started;
+        public double EpochUT;
+        public Guid VesselId;
+        public string LoadError="";
+        public bool RationsEnabled, DailyRoutineEnabled, SupplyDepleted;
+        public int UnfrozenMask=15;
+        public double SupplyUT, FoodUsed, WaterUsed, FoodMissing, WaterMissing;
+        public int PreviousUnfrozen;
+        public string SupplyError="";
+        public double LastTakenFood,LastTakenWater; // transient transaction results
+        ConfigNode preservedLoadNode;
+        void RejectLoad(ConfigNode node,string reason)
+        {Started=false;LoadError=reason;preservedLoadNode=node.CreateCopy();}
+        static bool ReadAmount(ConfigNode n,string key,out double value)
+        {return double.TryParse(n.GetValue(key),NumberStyles.Float,CultureInfo.InvariantCulture,out value)&&CampaignTiming.Finite(value)&&value>=0;}
+        public override void OnSave(ConfigNode node)
+        {
+            base.OnSave(node);
+            // Keep invalid/future data intact. A later save must not normalize
+            // rejected flags or discard unknown fields and repeated crew nodes.
+            if(preservedLoadNode!=null){node.ClearData();preservedLoadNode.CopyTo(node);return;}
+            node.AddValue("schema",1);node.AddValue("started",Started);
+            node.AddValue("epochUT",EpochUT.ToString("R",CultureInfo.InvariantCulture));
+            node.AddValue("vesselID",VesselId.ToString());
+            node.AddValue("dailyRoutineEnabled",DailyRoutineEnabled);node.AddValue("unfrozenMask",UnfrozenMask);
+            node.AddValue("supplyDepleted",SupplyDepleted);
+            node.AddValue("rationsEnabled",RationsEnabled);node.AddValue("supplyError",SupplyError);
+            node.AddValue("supplyUT",SupplyUT.ToString("R",CultureInfo.InvariantCulture));
+            node.AddValue("foodUsed",FoodUsed.ToString("R",CultureInfo.InvariantCulture));
+            node.AddValue("waterUsed",WaterUsed.ToString("R",CultureInfo.InvariantCulture));
+            node.AddValue("foodMissing",FoodMissing.ToString("R",CultureInfo.InvariantCulture));
+            node.AddValue("waterMissing",WaterMissing.ToString("R",CultureInfo.InvariantCulture));
+            node.AddValue("previousUnfrozen",PreviousUnfrozen);
+            if(CrewSnapshot!=null)CrewStateCodec.Save(node,CrewSnapshot);
+        }
+        public override void OnLoad(ConfigNode node)
+        {
+            base.OnLoad(node);
+            CrewSnapshot=null;Started=false;LoadError="";RationsEnabled=false;DailyRoutineEnabled=false;
+            UnfrozenMask=15;SupplyError="";SupplyDepleted=false;preservedLoadNode=null;
+            EpochUT=0;VesselId=Guid.Empty;SupplyUT=0;FoodUsed=0;WaterUsed=0;FoodMissing=0;WaterMissing=0;
+            PreviousUnfrozen=0;LastTakenFood=0;LastTakenWater=0;
+            bool requested;
+            if(!node.HasValue("started"))
+            {
+                if(node.HasValue("schema")||node.HasValue("epochUT")||node.HasValue("rationsEnabled")||node.HasValue("dailyRoutineEnabled")||node.HasValue("supplyUT")||node.HasNode("CAMPAIGN_CREW"))
+                    RejectLoad(node,"Missing campaign start flag; original data preserved.");
+                return;
+            }
+            if(!bool.TryParse(node.GetValue("started"),out requested))
+            {RejectLoad(node,"Invalid campaign start flag; original data preserved.");return;}
+            int schema;
+            if(!int.TryParse(node.GetValue("schema"),out schema)||schema!=1)
+            {RejectLoad(node,"Unsupported campaign schema; original data preserved.");return;}
+            if(!requested)return;
+            double epoch;Guid vessel;
+            if(!double.TryParse(node.GetValue("epochUT"),NumberStyles.Float,CultureInfo.InvariantCulture,out epoch)||
+                !CampaignTiming.Finite(epoch)||epoch<0||!Guid.TryParse(node.GetValue("vesselID"),out vessel)||vessel==Guid.Empty)
+            {RejectLoad(node,"Invalid campaign save data; original data preserved.");return;}
+            EpochUT=epoch;VesselId=vessel;Started=true;
+            if(node.HasNode("CAMPAIGN_CREW"))
+            {
+                try{CrewSnapshot=CrewStateCodec.Load(node);}
+                catch(FormatException){RejectLoad(node,"Invalid campaign crew snapshot; original data preserved.");return;}
+            }
+            if(node.HasValue("rationsEnabled"))
+            {
+                if(!bool.TryParse(node.GetValue("rationsEnabled"),out RationsEnabled))
+                {RejectLoad(node,"Invalid ration plan flag; original data preserved.");return;}
+            }
+            else if(node.HasValue("supplyUT")||node.HasValue("foodUsed")||node.HasValue("waterUsed"))
+            {RejectLoad(node,"Missing ration plan flag for saved ledger; original data preserved.");return;}
+            if(node.HasValue("dailyRoutineEnabled")&&!bool.TryParse(node.GetValue("dailyRoutineEnabled"),out DailyRoutineEnabled))
+            {RejectLoad(node,"Invalid daily routine flag; original data preserved.");return;}
+            if(DailyRoutineEnabled&&!RationsEnabled)
+            {RejectLoad(node,"Daily routine requires its finite ration plan; original data preserved.");return;}
+            if(RationsEnabled)
+            {
+                if(node.HasValue("unfrozenMask")&&(!int.TryParse(node.GetValue("unfrozenMask"),out UnfrozenMask)||UnfrozenMask<0||UnfrozenMask>15))
+                {RejectLoad(node,"Invalid saved crew history; original data preserved.");return;}
+                SupplyError=node.GetValue("supplyError")??"";
+                // Old candidates used depletion as a permanent error. Preserve
+                // their recorded shortfall, but resume only observed intervals.
+                if(SupplyError=="Routine rations depleted. Unmet supply demand recorded; coast blocked.")
+                {SupplyError="";SupplyDepleted=true;}
+                if(node.HasValue("supplyDepleted")&&!bool.TryParse(node.GetValue("supplyDepleted"),out SupplyDepleted))
+                {RejectLoad(node,"Invalid saved depletion state; original data preserved.");return;}
+                if(!ReadAmount(node,"supplyUT",out SupplyUT)||SupplyUT<EpochUT||
+                   !ReadAmount(node,"foodUsed",out FoodUsed)||!ReadAmount(node,"waterUsed",out WaterUsed)||
+                   !ReadAmount(node,"foodMissing",out FoodMissing)||!ReadAmount(node,"waterMissing",out WaterMissing)||
+                   !int.TryParse(node.GetValue("previousUnfrozen"),out PreviousUnfrozen)||PreviousUnfrozen<0||PreviousUnfrozen>4)
+                {RejectLoad(node,"Invalid saved supply ledger; original data preserved.");return;}
+            }
+        }
+    }
+    public sealed partial class MissionConsole
+    {
+        HermesCampaign Campaign
+        {
+            get
+            {
+                if(!Allowed)return null;
+                foreach(var proto in HighLogic.CurrentGame.scenarios)
+                    if(proto.moduleName==typeof(HermesCampaign).Name)return proto.moduleRef as HermesCampaign;
+                return null;
+            }
+        }
+        void BindCampaignCrew()
+        {
+            var campaign=Campaign;if(campaign==null||!campaign.Started)return;
+            if(campaign.CrewSnapshot==null)campaign.CrewSnapshot=crew;
+            else if(!object.ReferenceEquals(crew,campaign.CrewSnapshot)){careAction="";crew=campaign.CrewSnapshot;}
+        }
+        void BeginCampaign()
+        {
+            if(!Allowed||!HighLogic.LoadedSceneIsFlight||Ship==null)return;
+            var existing=Campaign;
+            if(existing!=null&&(existing.Started||existing.LoadError.Length>0))return;
+            if(!Aboard(crew[0].Name)||!Aboard(crew[1].Name)||Frozen(crew[0].Name)||Frozen(crew[1].Name))
+            {message="Both Hamish and Basil must be awake aboard Hermes to start.";return;}
+            foreach(var c in crew)if(!Aboard(c.Name)&&!Frozen(c.Name)){message="All four mission crew must be aboard Hermes, awake or in its pods.";return;}
+            double now=Planetarium.GetUniversalTime();
+            if(!CampaignTiming.Finite(now)||now<0)return;
+            var campaign=existing;
+            if(campaign==null){
+                var proto=HighLogic.CurrentGame.AddProtoScenarioModule(typeof(HermesCampaign),GameScenes.FLIGHT,GameScenes.SPACECENTER,GameScenes.TRACKSTATION);
+                campaign=proto.moduleRef as HermesCampaign;
+            }
+            if(campaign==null){message="Campaign module is not ready. No clock was started.";return;}
+            campaign.EpochUT=now;campaign.VesselId=Ship.id;campaign.CrewSnapshot=crew;campaign.Started=true;
+            message="Campaign epoch recorded in this game's scenario state. Save the game to persist it. Accelerated coast is not enabled yet.";
+        }
+        void DrawCampaign()
+        {
+            GUILayout.Label("HERMES EXPEDITION / 24 MISSION MONTHS");
+            GUILayout.Label("Three rotations: four months Hamish/Basil, then four months Ada/Vikram. Mission months are 30 standard 24-hour days. Actual KSP UT determines progress, including time spent burning.");
+            var campaign=Campaign;
+            if(campaign==null||(!campaign.Started&&campaign.LoadError.Length==0))
+            {
+                GUI.enabled=Allowed&&HighLogic.LoadedSceneIsFlight&&Ship!=null;
+                if(GUILayout.Button("Start campaign on this vessel"))BeginCampaign();GUI.enabled=true;
+                GUILayout.Label("Start once all four crew are aboard. This starts the campaign clock in the current game's scenario state; normal KSP saves/quicksaves preserve it.");return;
+            }
+            if(!campaign.Started){GUILayout.Label(campaign.LoadError.Length>0?campaign.LoadError:"Campaign state has not been initialized.");return;}
+            double now=Planetarium.GetUniversalTime();
+            if(!CampaignTiming.Finite(now)||now<campaign.EpochUT){GUILayout.Label("Campaign clock is inconsistent with saved epoch. Coast is disabled.");return;}
+            DrawCampaignSupplies(campaign);
+            int watch=CampaignTiming.WatchAt(campaign.EpochUT,now);
+            double months=Math.Min(24,(now-campaign.EpochUT)/CampaignTiming.MonthSeconds);
+            GUILayout.Label("Elapsed: "+months.ToString("F3")+" / 24 mission months");
+            if(watch==6){GUILayout.Label("Expedition clock complete. Perform crew recovery and mission review.");return;}
+            bool human=CampaignTiming.HumanWatch(watch);
+            GUILayout.Label("Watch "+(watch+1)+" / 6: "+(human?"Hamish + Basil":"Ada + Vikram")+" | Remaining mission days: "+((CampaignTiming.WatchEndUT(campaign.EpochUT,watch)-now)/86400).ToString("F2"));
+            bool bound=HighLogic.LoadedSceneIsFlight&&Ship!=null&&Ship.id==campaign.VesselId;
+            GUILayout.Label(bound?"Campaign vessel active":"Activate the original campaign vessel; vessel changes never silently rebind the campaign.");
+            GUILayout.Label("Coast BLOCKED: background needs, cryopod power and resource accounting are not yet certified. Current build retains 1x. Targets after qualification: human 540x, NPC 172800x. Minimum coast-only play time 16h3m; burns and handovers add time.");
+            GUILayout.Label("Burn plan and dual verification integration pending. Single-player role selection is rehearsal, not two authenticated player approvals.");
+        }
+    }
+}
diff --git a/Source/CampaignCoast.cs b/Source/CampaignCoast.cs
new file mode 100644
--- /dev/null
+++ b/Source/CampaignCoast.cs
@@ -0,0 +1,44 @@
+using System;
+namespace MegaCrew
+{
+    // Pure decision only. A future KSP adapter must refresh every observation on
+    // each dispatch, cap stock warp safely, and stop BEFORE StopUT. Never set UT.
+    public struct CoastObservation
+    {
+        public double EpochUT, CurrentUT, ObservedUT, NextStopUT, ResourcesVerifiedThroughUT;
+        public bool CampaignVessel, HumanPairAwake, HumanPairFrozen, ReliefPairAwake;
+        public bool CryoStateVerified, BackgroundAccountingVerified, HaltRequested;
+    }
+    public struct CoastDecision
+    {
+        public readonly double TargetRate, StopUT;
+        public readonly string Reason;
+        public bool CanAccelerate { get { return TargetRate>1; } }
+        public CoastDecision(double rate,double stop,string reason){TargetRate=rate;StopUT=stop;Reason=reason;}
+    }
+    public static class CampaignCoast
+    {
+        public static CoastDecision Decide(CoastObservation s)
+        {
+            if(!CampaignTiming.Finite(s.CurrentUT)||s.CurrentUT<0)return new CoastDecision(1,0,"Invalid clock");
+            double now=s.CurrentUT;
+            if(!CampaignTiming.Finite(s.EpochUT)||s.EpochUT<0||now<s.EpochUT)return Hold(now,"Invalid campaign epoch");
+            // Exact sample epoch: stale/future snapshots must never grant warp.
+            if(s.ObservedUT!=now)return Hold(now,"Refresh vessel observations");
+            if(!s.CampaignVessel||s.HaltRequested)return Hold(now,"Coast not authorized");
+            int watch=CampaignTiming.WatchAt(s.EpochUT,now);
+            if(watch==6)return Hold(now,"Campaign complete");
+            if(!s.CryoStateVerified||!s.BackgroundAccountingVerified)return Hold(now,"Cryo/resource accounting unverified");
+            bool human=CampaignTiming.HumanWatch(watch);
+            if(human&&(!s.HumanPairAwake||s.HumanPairFrozen))return Hold(now,"Human watch requires both human crew awake");
+            if(!human&&(!s.HumanPairFrozen||s.HumanPairAwake||!s.ReliefPairAwake))return Hold(now,"NPC watch requires frozen human crew and awake relief crew");
+            // NextStopUT includes alignment, work, handover, and operational limits,
+            // not merely ignition. Unknown next event refuses accelerated coast.
+            if(!CampaignTiming.Finite(s.NextStopUT)||s.NextStopUT<=now)return Hold(now,"Next operational stop missing or due");
+            double stop=Math.Min(s.NextStopUT,CampaignTiming.WatchEndUT(s.EpochUT,watch));
+            if(!CampaignTiming.Finite(s.ResourcesVerifiedThroughUT)||s.ResourcesVerifiedThroughUT<stop)return Hold(now,"Insufficient verified resource horizon");
+            return new CoastDecision(human?CampaignTiming.HumanCoastRate:CampaignTiming.NpcCoastRate,stop,"Coast candidate; runtime rate limits still apply");
+        }
+        static CoastDecision Hold(double now,string reason){return new CoastDecision(1,now,reason);}
+    }
+}
diff --git a/Source/CampaignEpochPlanner.cs b/Source/CampaignEpochPlanner.cs
new file mode 100644
--- /dev/null
+++ b/Source/CampaignEpochPlanner.cs
@@ -0,0 +1,65 @@
+using System;
+using System.Collections.Generic;
+namespace MegaCrew
+{
+    // Pre-start planning only. Neither this model nor its result edits campaign
+    // state, a trajectory, crew, KSP UT, or the fixed four-month watch lengths.
+    public struct BurnDutyInterval
+    {
+        public readonly double StartUT,EndUT;
+        public BurnDutyInterval(double ignitionUT,double burnSeconds,double alignSeconds,double verifySeconds)
+        {
+            if(!Valid(ignitionUT)||!Valid(burnSeconds)||!Valid(alignSeconds)||!Valid(verifySeconds)||burnSeconds<=0)
+                throw new ArgumentOutOfRangeException();
+            StartUT=ignitionUT-alignSeconds;EndUT=ignitionUT+burnSeconds+verifySeconds;
+            if(!Valid(StartUT)||!Valid(EndUT)||EndUT<=StartUT)throw new ArgumentOutOfRangeException();
+        }
+        static bool Valid(double n){return CampaignTiming.Finite(n)&&n>=0;}
+    }
+    public struct CampaignEpochWindow
+    {
+        public readonly double EarliestUT,LatestUT;
+        public CampaignEpochWindow(double earliest,double latest){EarliestUT=earliest;LatestUT=latest;}
+        public bool Contains(double epoch){return CampaignTiming.Finite(epoch)&&epoch>=EarliestUT&&epoch<=LatestUT;}
+    }
+    public static class CampaignEpochPlanner
+    {
+        // Intersect the candidate start range with each burn's three possible
+        // human-watch windows. An empty result means this fixed rotation cannot
+        // cover the supplied physical trajectory; the trajectory planner must
+        // propose and verify another real trajectory, not move ignition labels.
+        public static List<CampaignEpochWindow> Find(double earliestEpochUT,double latestEpochUT,IEnumerable<BurnDutyInterval> burns)
+        {
+            if(burns==null||!Valid(earliestEpochUT)||!Valid(latestEpochUT)||latestEpochUT<earliestEpochUT||
+                !Valid(latestEpochUT+CampaignTiming.MissionSeconds)||latestEpochUT+CampaignTiming.MissionSeconds<=latestEpochUT)
+                throw new ArgumentOutOfRangeException();
+            var feasible=new List<CampaignEpochWindow>{new CampaignEpochWindow(earliestEpochUT,latestEpochUT)};
+            int count=0;
+            foreach(var burn in burns)
+            {
+                if(++count>128)throw new ArgumentOutOfRangeException("burns","Review at most 128 burn duty intervals per plan");
+                if(!Valid(burn.StartUT)||!Valid(burn.EndUT)||burn.EndUT<=burn.StartUT)throw new ArgumentOutOfRangeException("burns");
+                var next=new List<CampaignEpochWindow>();
+                foreach(var current in feasible)
+                    for(int human=0;human<6;human+=2)
+                    {
+                        double first=Math.Max(current.EarliestUT,burn.EndUT-(human+1)*CampaignTiming.WatchSeconds);
+                        double last=Math.Min(current.LatestUT,burn.StartUT-human*CampaignTiming.WatchSeconds);
+                        if(first<=last)next.Add(new CampaignEpochWindow(first,last));
+                    }
+                next.Sort((a,b)=>a.EarliestUT.CompareTo(b.EarliestUT));
+                feasible=new List<CampaignEpochWindow>();
+                foreach(var range in next)
+                {
+                    int i=feasible.Count-1;
+                    if(i>=0&&range.EarliestUT<=feasible[i].LatestUT)
+                        feasible[i]=new CampaignEpochWindow(feasible[i].EarliestUT,Math.Max(feasible[i].LatestUT,range.LatestUT));
+                    else feasible.Add(range);
+                }
+                // Keep validating remaining input even after a conflict.
+            }
+            return feasible;
+        }
+        static bool Valid(double n){return CampaignTiming.Finite(n)&&n>=0;}
+    }
+}
diff --git a/Source/CampaignSupplies.cs b/Source/CampaignSupplies.cs
new file mode 100644
--- /dev/null
+++ b/Source/CampaignSupplies.cs
@@ -0,0 +1,100 @@
+using System;
+using System.Globalization;
+using UnityEngine;
+namespace MegaCrew
+{
+    // Fictional game tuning: routine meals/drinks are distributed continuously
+    // over a standard day. Frozen crew use neither. Extra manual meals cost extra.
+    public static class CampaignRations
+    {
+        public const double FoodPerCrewDay=1.5, WaterPerCrewDay=0.75;
+        public static double Demand(double seconds,int unfrozenCrew,double perCrewDay)
+        {
+            if(!CampaignTiming.Finite(seconds)||seconds<0||unfrozenCrew<0||unfrozenCrew>4||!CampaignTiming.Finite(perCrewDay)||perCrewDay<0)throw new ArgumentOutOfRangeException();
+            double amount=(seconds/86400)*unfrozenCrew*perCrewDay;
+            if(!CampaignTiming.Finite(amount))throw new ArgumentOutOfRangeException();return amount;
+        }
+        public static double Take(double available,double demand)
+        {
+            if(!CampaignTiming.Finite(available)||available<0||!CampaignTiming.Finite(demand)||demand<0)throw new ArgumentOutOfRangeException();
+            return Math.Min(available,demand);
+        }
+    }
+    public sealed partial class MissionConsole
+    {
+        void UpdateCampaignSupplies(double dt)
+        {
+            var c=Campaign;
+            if(c==null||!c.Started||!c.RationsEnabled||!HighLogic.LoadedSceneIsFlight||Ship==null||Ship.id!=c.VesselId||FlightDriver.Pause)return;
+            double now=Planetarium.GetUniversalTime();
+            if(!CampaignTiming.Finite(now)||now<c.SupplyUT){c.SupplyError="Supply clock regressed. Restore a consistent KSP save.";return;}
+            if(c.SupplyError.Length>0)return;
+            double elapsed=now-c.SupplyUT;
+            // Do not infer unknown crew histories across a scene load or offline
+            // interval. The future background adapter must reconcile these.
+            if(elapsed>60||dt<0||dt>60){c.SupplyError="Unobserved supply interval. Background reconciliation required; coast blocked.";return;}
+            if(elapsed<=0)return;
+            int awake=0,mask=0,crewIndex=0;
+            foreach(var person in crew)
+            {
+                bool frozen;
+                if(!CryoBridge.TryFrozen(person.Name,out frozen)||(!frozen&&!Aboard(person.Name)))
+                {c.SupplyError="Crew/pod state unavailable. Supply history requires reconciliation.";return;}
+                if(!frozen){awake++;mask|=1<<crewIndex;}crewIndex++;
+            }
+            // Charge the higher awake count on transitions. No free food from
+            // freezing at the end of an interval or double credit on thaw.
+            int observedMask=c.UnfrozenMask|mask,charge=0;
+            for(int i=0;i<4;i++)if((observedMask&(1<<i))!=0)charge++;
+            double food=CampaignRations.Demand(elapsed,charge,CampaignRations.FoodPerCrewDay);
+            double water=CampaignRations.Demand(elapsed,charge,CampaignRations.WaterPerCrewDay+(c.DailyRoutineEnabled?0.25:0));
+            c.FoodUsed+=ConsumeCampaignSupply("Food",food);
+            c.WaterUsed+=ConsumeCampaignSupply("Water",water);
+            // A shortfall becomes a durable unmet balance, never negative stores.
+            c.FoodMissing+=Math.Max(0,food-c.LastTakenFood);
+            c.WaterMissing+=Math.Max(0,water-c.LastTakenWater);
+            if(c.DailyRoutineEnabled)
+            {
+                double foodFraction=food>0?c.LastTakenFood/food:1,waterFraction=water>0?c.LastTakenWater/water:1;
+                for(int i=0;i<crew.Count;i++)DailyRoutine.Advance(crew[i],c.EpochUT,c.SupplyUT,now,i,(observedMask&(1<<i))==0,(observedMask&(1<<(i^1)))!=0,foodFraction,waterFraction);
+            }
+            c.SupplyUT=now;c.PreviousUnfrozen=awake;c.UnfrozenMask=mask;
+            // Shortage is a known observed state, not missing history. Keep
+            // accounting and physiology alive; never synthesize a meal or repay
+            // old unmet demand by silently taking extra stores after resupply.
+            c.SupplyDepleted=food-c.LastTakenFood>1e-8||water-c.LastTakenWater>1e-8;
+        }
+        double ConsumeCampaignSupply(string name,double demand)
+        {
+            double left=demand;
+            foreach(var p in Ship.parts)foreach(PartResource r in p.Resources)
+                if(r.resourceName==name&&r.flowState){double take=CampaignRations.Take(r.amount,left);r.amount-=take;left-=take;}
+            double taken=demand-left;var c=Campaign;
+            if(name=="Food")c.LastTakenFood=taken;else c.LastTakenWater=taken;
+            return taken;
+        }
+        void DrawCampaignSupplies(HermesCampaign c)
+        {
+            GUILayout.Label("Routine ration plan: 1.5 Food + 0.75 Water per unfrozen crew per standard day. Frozen crew consume neither; manual meals/drinks are additional. This accounts stores, not automatic task completion or physiological care.");
+            if(!c.RationsEnabled)
+            {
+                GUI.enabled=HighLogic.LoadedSceneIsFlight&&Ship!=null&&Ship.id==c.VesselId;
+                if(GUILayout.Button("Enable finite routine ration plan"))
+                {c.RationsEnabled=true;c.SupplyUT=Planetarium.GetUniversalTime();c.PreviousUnfrozen=4;c.UnfrozenMask=15;message="Routine ration plan enabled. Save the game to persist the plan and ledger.";}
+                GUI.enabled=true;
+            }
+            if(c.RationsEnabled&&!c.DailyRoutineEnabled)
+            {
+                GUI.enabled=HighLogic.LoadedSceneIsFlight&&Ship!=null&&Ship.id==c.VesselId&&c.SupplyError.Length==0;
+                if(GUILayout.Button("Schedule daily sleep, meals and crew care")){c.DailyRoutineEnabled=true;message="Daily routine scheduled: staggered eight-hour ordinary sleep and finite supplies; save to persist. No animated crew movement is implemented.";}
+                GUI.enabled=true;
+            }
+            if(c.DailyRoutineEnabled&&GUILayout.Button("Suspend daily routine for manual operations")){c.DailyRoutineEnabled=false;message="Automatic daily routine suspended; campaign clock continues. Wake crew manually as required. Routine rations remain finite.";}
+            if(c.DailyRoutineEnabled)GUILayout.Label("Daily routine active: each unfrozen crew rests eight hours per standard day, staggered within the pair. Modeled hygiene uses an extra 0.25 Water per crew/day; exercise/social care require time and awake coverage. No maintenance repairs are automatic.");
+            GUILayout.Label("Routine used: Food "+c.FoodUsed.ToString("F3")+", Water "+c.WaterUsed.ToString("F3")+" | Cumulative unmet: "+c.FoodMissing.ToString("F3")+" / "+c.WaterMissing.ToString("F3"));
+            if(c.SupplyDepleted)GUILayout.Label("Routine rations depleted. Observed needs and cumulative unmet demand continue; restore accessible supplies. Past shortfalls remain in the log. Coast blocked.");
+            if(c.SupplyError.Length>0)GUILayout.Label(c.SupplyError);
+            GUILayout.Label("24-month baseline with two unfrozen crew: 2160 Food + 1080 Water (1440 Water with daily hygiene), before reserve, handovers and extra meals. Existing small pantry alone is insufficient. No free provisions are added by this plan.");
+        }
+    }
+}
diff --git a/Source/CampaignTiming.cs b/Source/CampaignTiming.cs
new file mode 100644
--- /dev/null
+++ b/Source/CampaignTiming.cs
@@ -0,0 +1,47 @@
+using System;
+
+namespace MegaCrew
+{
+    // Pure UT contract for the future warp controller and maneuver planner.
+    // No method here changes KSP time, crew, resources, nodes or throttle.
+    public static class CampaignTiming
+    {
+        public const double MonthSeconds = 30 * 24 * 3600;
+        public const double WatchSeconds = 4 * MonthSeconds;
+        public const double MissionSeconds = 24 * MonthSeconds;
+        public const double HumanCoastRate = MonthSeconds / (80 * 60);
+        public const double NpcCoastRate = WatchSeconds / 60;
+        public const double BaselinePlaySeconds = 3 * (4 * 80 * 60 + 60);
+        public static bool Finite(double value){return !double.IsNaN(value)&&!double.IsInfinity(value);}
+        static void Time(double value,string name){if(!Finite(value)||value<0)throw new ArgumentOutOfRangeException(name);}
+        // Returns 6 at/after completion; never wraps back to the first watch.
+        public static int WatchAt(double epochUT,double currentUT)
+        {
+            Time(epochUT,"epochUT");Time(currentUT,"currentUT");
+            if(currentUT<epochUT)throw new ArgumentOutOfRangeException("currentUT","Clock is before the recorded campaign epoch");
+            return (int)Math.Min(6,Math.Floor((currentUT-epochUT)/WatchSeconds));
+        }
+        public static bool HumanWatch(int watch){if(watch<0||watch>5)throw new ArgumentOutOfRangeException("watch");return watch%2==0;}
+        public static double WatchEndUT(double epochUT,int watch)
+        {
+            Time(epochUT,"epochUT");if(watch<0||watch>5)throw new ArgumentOutOfRangeException("watch");
+            double end=epochUT+(watch+1)*WatchSeconds;if(!Finite(end))throw new ArgumentOutOfRangeException("epochUT");return end;
+        }
+        // The entire alignment/burn/verification interval must lie in one human watch.
+        // The solver must revise the watch plan if this fails; never move a burn epoch arbitrarily.
+        public static bool CoversBurn(double epochUT,double ignitionUT,double burnSeconds,double alignSeconds,double verifySeconds)
+        {
+            Time(epochUT,"epochUT");Time(ignitionUT,"ignitionUT");Time(burnSeconds,"burnSeconds");Time(alignSeconds,"alignSeconds");Time(verifySeconds,"verifySeconds");
+            double start=ignitionUT-alignSeconds,end=ignitionUT+burnSeconds+verifySeconds;
+            if(!Finite(end)||start<epochUT)return false;
+            int watch=WatchAt(epochUT,start);
+            return watch<6&&HumanWatch(watch)&&end<=WatchEndUT(epochUT,watch);
+        }
+        public static double ExtraBurnPlaySeconds(double burnSeconds,double executionRate=1)
+        {
+            Time(burnSeconds,"burnSeconds");if(!Finite(executionRate)||executionRate<=0||executionRate>HumanCoastRate)throw new ArgumentOutOfRangeException("executionRate");
+            double extra=burnSeconds/executionRate-burnSeconds/HumanCoastRate;
+            if(!Finite(extra))throw new ArgumentOutOfRangeException("burnSeconds");return extra;
+        }
+    }
+}
