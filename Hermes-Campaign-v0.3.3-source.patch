+++ b/Source/CrewStateCodec.cs
@@ -0,0 +1,51 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+namespace MegaCrew
+{
+    // KSP scenario snapshot shares the same save/quicksave as vessel resources.
+    public static class CrewStateCodec
+    {
+        static readonly string[] Names={"Hamish Kerman","Basil Kerman","Ada Kerman","Vikram Kerman"};
+        static void Number(ConfigNode n,string key,double value){n.AddValue(key,value.ToString("R",CultureInfo.InvariantCulture));}
+        static double Read(ConfigNode n,string key,double max)
+        {
+            double v;
+            if(!double.TryParse(n.GetValue(key),NumberStyles.Float,CultureInfo.InvariantCulture,out v)||double.IsNaN(v)||double.IsInfinity(v)||v<0||v>max)throw new FormatException("Invalid crew metric");
+            return v;
+        }
+        static double Stamp(ConfigNode n,string key)
+        {
+            double v;if(!double.TryParse(n.GetValue(key),NumberStyles.Float,CultureInfo.InvariantCulture,out v)||double.IsNaN(v)||double.IsInfinity(v)||v< -1)throw new FormatException("Invalid care timestamp");return v;
+        }
+        public static void Save(ConfigNode root,List<CrewRecord> crew)
+        {
+            foreach(var c in crew)
+            {
+                var n=root.AddNode("CAMPAIGN_CREW");n.AddValue("name",c.Name);n.AddValue("role",c.Role);n.AddValue("injury",c.Injury);
+                n.AddValue("resting",c.Resting);n.AddValue("treated",c.Treated);
+                Number(n,"hunger",c.Hunger);Number(n,"thirst",c.Thirst);Number(n,"fatigue",c.Fatigue);Number(n,"recovery",c.Recovery);
+                Number(n,"hygiene",c.Hygiene);Number(n,"conditioning",c.Conditioning);Number(n,"morale",c.Morale);
+                Number(n,"hygieneDoneUT",c.HygieneDoneUT);Number(n,"exerciseDoneUT",c.ExerciseDoneUT);Number(n,"socialDoneUT",c.SocialDoneUT);
+            }
+        }
+        public static List<CrewRecord> Load(ConfigNode root)
+        {
+            var nodes=root.GetNodes("CAMPAIGN_CREW");if(nodes.Length!=4)throw new FormatException("Expected four crew");
+            var result=new List<CrewRecord>();
+            foreach(string name in Names)
+            {
+                ConfigNode found=null;
+                foreach(var n in nodes)if(n.GetValue("name")==name){if(found!=null)throw new FormatException("Duplicate crew");found=n;}
+                if(found==null)throw new FormatException("Missing crew");
+                var c=new CrewRecord(name,found.GetValue("role")??"");
+                c.Hunger=Read(found,"hunger",100);c.Thirst=Read(found,"thirst",100);c.Fatigue=Read(found,"fatigue",100);c.Recovery=Read(found,"recovery",double.MaxValue);
+                c.Hygiene=Read(found,"hygiene",100);c.Conditioning=Read(found,"conditioning",100);c.Morale=Read(found,"morale",100);
+                c.HygieneDoneUT=Stamp(found,"hygieneDoneUT");c.ExerciseDoneUT=Stamp(found,"exerciseDoneUT");c.SocialDoneUT=Stamp(found,"socialDoneUT");
+                if(!bool.TryParse(found.GetValue("resting"),out c.Resting)||!bool.TryParse(found.GetValue("treated"),out c.Treated))throw new FormatException("Invalid crew flags");
+                c.Injury=found.GetValue("injury")??"None";result.Add(c);
+            }
+            return result;
+        }
+    }
+}
diff --git a/Source/DailyRoutine.cs b/Source/DailyRoutine.cs
new file mode 100644
--- /dev/null
+++ b/Source/DailyRoutine.cs
@@ -0,0 +1,51 @@
+using System;
+namespace MegaCrew
+{
+    // Deterministic gameplay routines over actual KSP UT, not a replacement clock.
+    // Call only for observed, resource-accounted intervals; no part repair/animation.
+    public static class DailyRoutine
+    {
+        public const double Day=86400, SleepSeconds=8*3600;
+        static void Time(double t){if(double.IsNaN(t)||double.IsInfinity(t)||t<0)throw new ArgumentOutOfRangeException("time");}
+        static double Phase(double epoch,double ut,int index)
+        {
+            double phase=(ut-epoch-(index%2)*43200)%Day;return phase<0?phase+Day:phase;
+        }
+        public static bool RestingAt(double epoch,double ut,int index)
+        {
+            Time(epoch);Time(ut);if(ut<epoch||index<0||index>3)throw new ArgumentOutOfRangeException();
+            return Phase(epoch,ut,index)<SleepSeconds;
+        }
+        static double UntilBoundary(double epoch,double ut,int index)
+        {
+            double p=Phase(epoch,ut,index);return p<SleepSeconds?SleepSeconds-p:Day-p;
+        }
+        public static void Advance(CrewRecord c,double epoch,double start,double end,int index,bool frozen,bool partnerUnfrozen,double foodFraction,double waterFraction)
+        {
+            Time(epoch);Time(start);Time(end);
+            if(c==null||start<epoch||end<start||end-start>CampaignTiming.MissionSeconds||index<0||index>3||
+                double.IsNaN(foodFraction)||foodFraction<0||foodFraction>1||double.IsNaN(waterFraction)||waterFraction<0||waterFraction>1)throw new ArgumentOutOfRangeException();
+            if(frozen){c.Resting=false;c.Fatigue=NeedsModel.Clamp(c.Fatigue-(end-start)*100/43200);return;}
+            double now=start;
+            while(now<end)
+            {
+                // Split at both crewmates' rest boundaries, so the outcome is
+                // independent of frame size even over multiple mission days.
+                double span=Math.Min(end-now,Math.Min(UntilBoundary(epoch,now,index),UntilBoundary(epoch,now,index^1)));
+                if(span<=0||now+span<=now)throw new InvalidOperationException("Routine clock cannot advance");
+                double midpoint=now+span/2;
+                bool resting=partnerUnfrozen&&RestingAt(epoch,midpoint,index);
+                double days=span/Day;
+                c.Hunger=NeedsModel.Clamp(c.Hunger+days*(100-120*foodFraction));
+                c.Thirst=NeedsModel.Clamp(c.Thirst+days*(100-120*waterFraction));
+                c.Fatigue=NeedsModel.Clamp(c.Fatigue+span*(resting?-100.0/43200:100.0/86400));
+                c.Hygiene=NeedsModel.Clamp(c.Hygiene+days*(-25+(resting?0:45*waterFraction)));
+                c.Conditioning=NeedsModel.Clamp(c.Conditioning+days*(-15+(resting||c.Injury!="None"?0:30*Math.Min(foodFraction,waterFraction))));
+                bool together=partnerUnfrozen&&!resting&&!RestingAt(epoch,midpoint,index^1);
+                c.Morale=NeedsModel.Clamp(c.Morale+days*(-10+(together?45:0)));
+                now+=span;
+            }
+            c.Resting=partnerUnfrozen&&RestingAt(epoch,end,index);
+        }
+    }
+}
